{
  "manifest_version": 3,
  "name": "Ad Blocker",
  "version": "2.0",
  "description": "Blocks specified URLs with a toggle UI.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}